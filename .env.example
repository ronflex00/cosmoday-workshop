# MQTT
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TLS_PORT=8883
MQTT_USERNAME=sentinel
MQTT_PASSWORD=CHANGE_ME
MQTT_TLS=false
# MQTT_TLS_CA=/absolute/path/provided-by-infra/ca.crt
# MQTT_TLS_CERT=/absolute/path/provided-by-infra/client.crt
# MQTT_TLS_KEY=/absolute/path/provided-by-infra/client.key

# Database
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://sentinel:CHANGE_ME@db:5432/sentinel

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
API_HISTORY_LIMIT=120

# Dashboard — copier ces variables dans frontend/.env (chargé par Vite)
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8000/ws
VITE_DATA_STALE_SECONDS=30

# AI
CAMERA_INDEX=0
AI_MODEL=yolov8n.pt
AI_CONFIDENCE=0.55
AI_FRAME_SKIP=2

# AI vision (these names take precedence over CAMERA_INDEX / AI_MODEL / AI_FRAME_SKIP)
AI_CAMERA_INDEX=0
AI_CAMERA_WIDTH=640
AI_CAMERA_HEIGHT=480
AI_YOLO_MODEL=yolov8n.pt
AI_PROCESS_EVERY_N_FRAMES=3
AI_INFERENCE_SIZE=320
AI_SHOW_WINDOW=false
AI_TRAINING_SAMPLES=20
AI_CONTAMINATION=0.1
AI_LOG_LEVEL=INFO

# For TLS, select MQTT_PORT=8883 and configure the paths in the MQTT section.
