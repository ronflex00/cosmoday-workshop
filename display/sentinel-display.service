[Unit]
Description=Sentinel-X local PiTFT dashboard
After=network-online.target docker.service getty@tty1.service
Wants=network-online.target

[Service]
Type=simple
User=sentinelpi1
SupplementaryGroups=video tty
WorkingDirectory=/home/sentinelpi1/cosmoday-workshop/display
ExecStartPre=+/usr/bin/chmod g+w /dev/tty1
ExecStart=/usr/bin/python3 /home/sentinelpi1/cosmoday-workshop/display/sentinel_dashboard.py --tty /dev/tty1
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_SYS_TTY_CONFIG
CapabilityBoundingSet=CAP_SYS_TTY_CONFIG
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
DevicePolicy=closed
DeviceAllow=/dev/fb0 rw
DeviceAllow=/dev/tty1 rw
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
