MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
# MQTT_TLS_CA=/absolute/path/provided-by-infra/ca.crt
# MQTT_TLS_CERT=/absolute/path/provided-by-infra/client.crt
# MQTT_TLS_KEY=/absolute/path/provided-by-infra/client.key

API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
API_HISTORY_LIMIT=120

# SQLite paths are relative to backend/. The table is created at API startup.
DATABASE_URL=sqlite:///data/sentinel.db
# PostgreSQL on the host: replace these placeholder credentials.
# DATABASE_URL=postgresql://sentinel:CHANGE_ME@127.0.0.1:5432/sentinel
