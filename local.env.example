# Optional local launcher configuration: copy to .env.local.
# Shell environment variables take precedence. Values are read as data, not shell code.
MQTT_HOST=localhost
MQTT_PORT=18883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_HOST=localhost
FRONTEND_PORT=5173
AI_CAMERA_INDEX=0
AI_SHOW_WINDOW=false
AI_TRAINING_SAMPLES=20
AI_CONTAMINATION=0.1
# API/WS URLs and CORS are derived from the above ports unless overridden.
# VITE_API_URL=http://localhost:8000
# VITE_WS_URL=ws://localhost:8000/ws
# CORS_ORIGINS=http://localhost:5173
