# Optional local launcher configuration: copy to .env.local.
# Shell environment variables take precedence. Values are read as data, not shell code.
MQTT_HOST=localhost
MQTT_PORT=18883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
API_HOST=127.0.0.1
API_PORT=8000
# Keep interpretation/events enabled without automatic physical alarms.
AI_AUTO_ALARM=false
FRONTEND_HOST=localhost
FRONTEND_PORT=5173
AI_CAMERA_INDEX=0
AI_SHOW_WINDOW=false
AI_VISION_STREAM_HOST=127.0.0.1
AI_VISION_STREAM_PORT=8765
AI_TRAINING_SAMPLES=20
AI_CONTAMINATION=0.1
# Persistent local history (relative SQLite paths are resolved from backend/).
# DATABASE_URL=sqlite:///data/sentinel.db
# DATABASE_URL=postgresql://sentinel:CHANGE_ME@127.0.0.1:5432/sentinel
# API/WS/vision URLs and CORS are derived from the above ports unless overridden.
# VITE_API_URL=http://localhost:8000
# VITE_WS_URL=ws://localhost:8000/ws
# CORS_ORIGINS=http://localhost:5173
# AI_VISION_STREAM_ORIGIN=http://localhost:5173
# VITE_VISION_STREAM_URL=http://127.0.0.1:8765/stream.mjpg
